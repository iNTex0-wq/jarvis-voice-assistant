

# --- LLM Backend: "ollama"" ---
LLM_BACKEND=ollama

# Ollama (local, on your PC)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b



# --- Web search (Tavily, free tier: tavily.com) ---
TAVILY_API_KEY=

# --- Proxmox ---
# Create a read-only API token: Datacenter > Permissions > API Tokens
PROXMOX_HOST=https://192.168.1.X:8006
PROXMOX_NODE=pve
PROXMOX_TOKEN_ID=root@pam!jarvis
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false

# --- Assistant ---
ASSISTANT_NAME=Jarvis
WAKE_WORD=jarvis
